{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "svt",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const fs=require('fs'),h=require('http');h.createServer((q,r)=>{const p=q.url==='/'?'/index.html':decodeURIComponent(q.url.split('?')[0]);try{const b=fs.readFileSync('.'+p);r.writeHead(200,{'Content-Type':p.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream','Cache-Control':'no-store'});r.end(b)}catch(e){r.writeHead(404);r.end('404')}}).listen(8777,()=>console.log('up on 8777'))"],
      "port": 8777
    }
  ]
}
